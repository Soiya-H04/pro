      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Genetic Regulatory Systems; Markov processes; Algebraic/geometric methods; Event-triggered control; Network Analysis and Control</pdf:Keywords>
